SELECT ?item ?itemLabel ?value ?website WHERE {
  ?item wdt:P31/wdt:P279* wd:Q8502 ;
        wdt:P17 wd:Q40 ;
        wdt:P2044 ?value .

  FILTER(?value > 2800)
  OPTIONAL { ?item wdt:P856 ?website . }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,uk". }
}
ORDER BY DESC(?value) ?item
LIMIT 20