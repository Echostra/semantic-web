SELECT ?item ?itemLabel ?region ?regionLabel ?population WHERE {
  ?item wdt:P31/wdt:P279* wd:Q8502 ;
        wdt:P17 wd:Q40 ;
        wdt:P131 ?region .

  ?region wdt:P1082 ?population .

  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,uk". }
}
ORDER BY DESC(?population) ?item
LIMIT 10